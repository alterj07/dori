# Copy this file to .env and fill it in. Never commit .env.

# NVIDIA API key from build.nvidia.com (starts with nvapi-)
NVIDIA_API_KEY=nvapi-your-key

# LoopMessage API key: dashboard -> API -> Settings
LOOP_API_KEY=your-loopmessage-api-key

# Any long random string. Paste the same value into the LoopMessage
# "Sandbox Webhook Header" field.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Your fixed ngrok domain, without https://
NGROK_DOMAIN=your-name.ngrok-free.app
